    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
