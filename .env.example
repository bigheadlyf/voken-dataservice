APP_ENV=test
WEB_PREFIX=
CORS_ALLOW_ORIGINS=*
DATABASE_URL=mysql+pymysql://voken:replace-me@127.0.0.1:3306/voken?charset=utf8mb4
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Analysis uses the advanced tier; chat/judgment use LLM_MODEL by default.
LLM_ADVANCED_MODEL=deepseek-v4-pro
# Optional per-scenario overrides (empty means use the tier default).
LLM_CHAT_MODEL=
LLM_JUDGMENT_MODEL=
LLM_ANALYSIS_MODEL=
LLM_API_KEY=
# Search/fetch always use https://api.deepseek.com, independently of LLM settings.
TOOLS_API_KEY=
UPKUAJING_API_KEY=
HUNTER_API_KEY=
HUNTER_DAILY_CALL_LIMIT=20
# Operator cost estimate only; actual Hunter credit usage is recorded separately.
HUNTER_CONTACT_ESTIMATE_MILLI_CNY=170
UPKUAJING_DAILY_CALL_LIMIT=5
POINTS_DEFAULT_COST=1
POINTS_OPERATION_COSTS={}
# Public search/page cache is workspace-scoped; 0 disables it. Maximum 86400.
PUBLIC_CACHE_TTL_SECONDS=21600
# Search can return page content at the same per-request price; fetch fills gaps only.
SEARCH_INCLUDE_CONTENT=true
# Optional official UK company register key. GLEIF and TED do not require one.
COMPANIES_HOUSE_API_KEY=
PUBLIC_SOURCE_DAILY_CALL_LIMIT=100
# A configurable CNY estimate, not an upstream invoice or live FX conversion.
PUBLIC_TOOL_ESTIMATE_MILLI_CNY=6

# Optional Aliyun mainland SMS verification. Leave all empty until sign/template approval.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_SECRET=

# Optional reviewed single-mail SMTP sender, bound to exactly one workspace.
SMTP_ENABLED=false
SMTP_WORKSPACE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Sender identity/address; a fixed reply-STOP sentence is appended and shown before sending.
SMTP_FOOTER=
SMTP_DAILY_LIMIT=20

# Optional ZeroBounce single-email checks. Credits are billed by the provider, not platform points.
# https://www.zerobounce.net/docs/email-validation-api-quickstart/v2-validate-emails
EMAIL_VALIDATION_API_KEY=
EMAIL_VALIDATION_WORKSPACE_ID=
EMAIL_VALIDATION_DAILY_LIMIT=20
# Optional read-only IMAP inbox import (TLS 993); archives require user review.
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_WORKSPACE_ID=

# WeChat Native APIv3. No payment calls are made while disabled.
WECHAT_ENABLED=false
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_KEY_ID=
WECHAT_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
